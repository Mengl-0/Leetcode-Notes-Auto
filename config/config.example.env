# =====================================================================
# LeetCode-Notes-Auto 配置模板
#
# 使用方法：
#   1. 复制本文件为 config/secret.env（同目录下）
#   2. 把 your-xxx 占位值替换为真实配置
#   3. config/secret.env 已被 .gitignore 忽略，不会提交到 GitHub
#
# 说明：
#   - 所有配置项也可以改用同名环境变量提供，环境变量优先级高于本文件
#   - 只填写你要用的模块即可，未配置的模块会在运行时给出友好提示并安全降级
#   - 本模板文件本身不含任何真实密钥，可安全提交
# =====================================================================

# ---------------------------------------------------------------------
# 1) 阿里云 OSS 图床（功能：截图自动上传、md 图片链接替换）
#    获取方式：阿里云控制台 -> AccessKey 管理 / OSS Bucket 列表
# ---------------------------------------------------------------------
OSS_ACCESS_KEY_ID=your-oss-access-key-id
OSS_ACCESS_KEY_SECRET=your-oss-access-key-secret
# Bucket 所在地域的外网 Endpoint，例如杭州为 oss-cn-hangzhou.aliyuncs.com
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET_NAME=your-bucket-name
# 图片在 Bucket 内的存放前缀（目录），可留空
OSS_PREFIX=img/
# 可选：自定义访问域名 / CDN 域名，留空则按 bucket + endpoint 自动推导
# OSS_URL_BASE=https://cdn.your-domain.com

# ---------------------------------------------------------------------
# 2) DeepSeek 大模型（功能：AI 题解分析、每日总结、Python/Go 互转、代码检查）
#    获取方式：platform.deepseek.com -> API Keys
#    接口为 OpenAI 兼容格式，base_url 一般无需修改
# ---------------------------------------------------------------------
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 可选模型：deepseek-flash（默认，便宜快速） / deepseek-v4-pro（能力更强，费用约为 flash 的 3 倍）
DEEPSEEK_MODEL=deepseek-flash
# 生成随机性，0~1，越低越稳定；题解分析建议 0.2~0.4
DEEPSEEK_TEMPERATURE=0.3
# 单次回复最大 token 数
DEEPSEEK_MAX_TOKENS=2048
# 请求超时秒数
DEEPSEEK_TIMEOUT=120

# ---------------------------------------------------------------------
# 3) 向量化 / RAG 私有知识库（功能：笔记问答）
#
#    provider 三选一：
#      hash                  零依赖本地哈希向量，默认值，无需安装任何包、完全离线，
#                            适合几十到几百篇笔记的规模，开箱即用
#      sentence_transformers 本地语义模型，检索质量最好，但需安装依赖并下载模型：
#                            pip install sentence-transformers
#      openai_compatible     调用第三方 OpenAI 兼容 embedding 接口，
#                            如阿里云百炼 text-embedding-v3、硅基流动 bge-m3
#
#    注意：DeepSeek 官方目前只提供对话模型，不提供 embedding 接口，
#          因此语义向量化需另选服务商或使用本地模型。
# ---------------------------------------------------------------------
EMBEDDING_PROVIDER=hash
# provider=sentence_transformers 时使用的本地模型名
EMBEDDING_MODEL=BAAI/bge-m3
# provider=openai_compatible 时填写，例如：
#   阿里云百炼 https://dashscope.aliyuncs.com/compatible-mode/v1
#   硅基流动   https://api.siliconflow.cn/v1
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
# provider=hash 时的向量维度，64~4096，越大越精细、索引文件越大
EMBEDDING_DIM=512

# RAG 检索参数
# 单个知识块最大字符数
RAG_CHUNK_MAX_CHARS=1200
# 每次问答召回的知识块数量
RAG_TOP_K=4
# 相似度低于该值的片段不用于回答，避免答非所问
RAG_MIN_SCORE=0.02
